<Configuration>
  <!--
    untrusted.wsb — test a file or program you do not trust.

    Locked down on purpose: no network, no GPU sharing, no microphone,
    no camera, no clipboard, no printers, and Protected Client on.
    Nothing you do inside the sandbox survives closing it, except
    changes to a writable mapped folder — and this profile maps none.

    To test a specific file, do NOT edit this file by hand. Generate
    a copy with a read-only mapped folder instead:

      .\scripts\New-SandboxConfig.ps1 -Profile Untrusted `
        -HostFolder 'C:\Users\Public\Downloads\untrusted' `
        -OutputPath '.\untrusted-test.wsb' -Launch

    The mapped host folder must already exist, or the sandbox
    fails to start.
  -->
  <vGPU>Disable</vGPU>
  <Networking>Disable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <ProtectedClient>Enable</ProtectedClient>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <MemoryInMB>4096</MemoryInMB>
</Configuration>
